# label: Gemma 4 Default Mode
# Recommendation: gemma4:26b
# Notes: Only Ollama Gemma 4 models are currently supported. If Ollama runs on hosted machine, use "http://host.docker.internal:<port>" as base URL.
AI_PROVIDER=gemma
MAX_SNAPSHOTS_HISTORY=1
CONTEXT_COMPRESSION=true
COMPRESSION_THRESHOLD_MIN=12500
COMPRESSION_THRESHOLD_LEAP=5000
LARGE_CONTENT_THRESHOLD=10000
MAX_ITERATIONS=100
MAXIMUM_RESTRICTED_TOOL_USAGE=5