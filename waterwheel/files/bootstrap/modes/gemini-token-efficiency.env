# label: Gemini Token Efficiency Mode
# provider: Gemini
# recommendation: gemini-2.5-flash
# notes: Only gemini-2.5-flash and gemini-2.5-pro are currently supported
AI_PROVIDER=gemini
MAX_SNAPSHOTS_HISTORY=0
CONTEXT_COMPRESSION=true
COMPRESSION_THRESHOLD_MIN=12500
COMPRESSION_THRESHOLD_LEAP=5000
LARGE_CONTENT_THRESHOLD=10000
RATE_LIMIT_RETRY=2
MAX_ITERATIONS=100
MAXIMUM_RESTRICTED_TOOL_USAGE=3