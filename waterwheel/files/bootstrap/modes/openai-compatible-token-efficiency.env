# label: OpenAI-Compatible Token Efficiency Mode
# provider: OpenAI-Compatible
# notes: Requires a base URL including the vendor's full version path (e.g. https://openrouter.ai/api/v1). Answer no to "Send temperature" for reasoning models that reject the field.
AI_PROVIDER=openai-compatible
AI_MAX_TOKENS=8192
MAX_SNAPSHOTS_HISTORY=0
CONTEXT_COMPRESSION=true
COMPRESSION_THRESHOLD_MIN=18500
COMPRESSION_THRESHOLD_LEAP=5500
LARGE_CONTENT_THRESHOLD=10000
RATE_LIMIT_RETRY=2
MAX_ITERATIONS=100
MAXIMUM_RESTRICTED_TOOL_USAGE=3
